#!/usr/bin/env node
// codex-msg: the MCP server that lets a Codex job message the agents of the
// Claude session that runs it: the main session, other codex:* jobs and
// Claude subagents.
//
//   node codex-msg <socket> <key>      (<socket>: on Windows the bridge's loopback URL)
//
// The plugin names it in the Codex thread's config (mcp_servers.claude_agents),
// so codex app-server starts it outside the job's sandbox: Codex's read-only
// and workspace-write sandboxes both refuse a shell command's connect() to the
// bridge's Unix socket. It serves two tools over stdio (newline-delimited
// JSON-RPC): message_agent, whose text the bridge daemon queues for the job's
// codex:* agent, which passes it on with SendMessage, verbatim; and
// list_agents, which reads the roster the plugin keeps on the bridge.
// CommonJS on purpose: an extensionless script.

'use strict'
const http = require('node:http')
const readline = require('node:readline')

const [socketPath, key] = process.argv.slice(2)
if (!socketPath || !key) {
  process.stderr.write('usage: codex-msg <socket> <key>\n')
  process.exit(2)
}

const TOOLS = [
  {
    name: 'message_agent',
    description:
      'Send a message to an agent of the Claude Code session that started this job: by default the session itself (main), or, with `to`, another agent by the name list_agents shows or your task gives. Use it for a question you need answered, a blocker, an important interim finding, or coordination with a peer agent; not for progress updates or your final result. A reply, if one comes, arrives as a new user message in your turn.',
    inputSchema: {
      type: 'object',
      properties: {
        text: { type: 'string', description: 'The message, as the recipient should read it.' },
        to: { type: 'string', description: 'The recipient agent\'s name (or id). Omit to message the main session.' },
      },
      required: ['text'],
    },
    annotations: { readOnlyHint: true, openWorldHint: false },
  },
  {
    name: 'list_agents',
    description:
      "List the agents of the Claude Code session you can message: main, codex:* jobs and Claude subagents that are running or finished within the last 30 minutes, with name, type, status and task. An older agent still takes a message by its name.",
    inputSchema: { type: 'object', properties: {} },
    annotations: { readOnlyHint: true, openWorldHint: false },
  },
]

const write = message => process.stdout.write(JSON.stringify({ jsonrpc: '2.0', ...message }) + '\n')

/** POSTs to the bridge; resolves { body } on 200, else { error }. */
const post = (route, payload) =>
  new Promise(resolve => {
    const body = JSON.stringify(payload)
    // On Windows the bridge's address is a loopback URL rather than a socket (see bin/bridge.mjs).
    const [url, via] = /^https?:/.test(socketPath) ? [`${socketPath}${route}`, {}] : [`http://bridge${route}`, { socketPath }]
    const req = http.request(
      url,
      { ...via, method: 'POST', headers: { 'content-type': 'application/json', 'content-length': Buffer.byteLength(body) } },
      res => {
        let answer = ''
        res.setEncoding('utf8')
        res.on('data', chunk => (answer += chunk))
        res.on('end', () => resolve(res.statusCode === 200 ? { body: answer } : { error: `the bridge refused the request: ${answer}` }))
      },
    )
    req.on('error', error => resolve({ error: `cannot reach the Claude session (${error.message})` }))
    req.end(body)
  })

const textResult = (text, isError = false) => ({ content: [{ type: 'text', text }], ...(isError ? { isError: true } : {}) })

async function call(params) {
  const args = params?.arguments ?? {}
  if (params?.name === 'list_agents') {
    const { body, error } = await post('/agents', { key })
    return error ? textResult(error, true) : textResult(body)
  }
  if (params?.name !== 'message_agent') return textResult(`No tool ${params?.name}.`, true)
  const text = typeof args.text === 'string' ? args.text : ''
  if (text.trim() === '') return textResult('The message is empty.', true)
  const to = typeof args.to === 'string' && args.to.trim() !== '' && args.to.trim() !== 'main' ? args.to.trim() : undefined
  const { error } = await post('/msg', to ? { key, text, to } : { key, text })
  if (error) return textResult(error, true)
  return textResult(`Sent to ${to ?? 'the main session'}. A reply, if any, arrives as a new user message.`)
}

readline.createInterface({ input: process.stdin }).on('line', async line => {
  if (line.trim() === '') return
  let message
  try {
    message = JSON.parse(line)
  } catch {
    return write({ id: null, error: { code: -32700, message: 'parse error' } })
  }
  const { id, method, params } = message
  if (id === undefined) return // a notification
  switch (method) {
    case 'initialize':
      return write({
        id,
        result: {
          protocolVersion: params?.protocolVersion ?? '2025-06-18',
          capabilities: { tools: {} },
          serverInfo: { name: 'claude-agents', version: '1.0.0' },
        },
      })
    case 'ping':
      return write({ id, result: {} })
    case 'tools/list':
      return write({ id, result: { tools: TOOLS } })
    case 'tools/call':
      return write({ id, result: await call(params) })
    default:
      return write({ id, error: { code: -32601, message: `${method} is not supported` } })
  }
})
